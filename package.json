{
  "name": "examguard-desktop",
  "version": "0.1.1",
  "private": true,
  "author": "UniCORE",
  "description": "ExamGuard desktop exam client",
  "desktopName": "ExamGuard",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "test": "node --test src/main/*.test.js src/renderer/src/*.test.js",
    "prepackage": "node ./scripts/check-production-api-config.js",
    "prepackage:linux": "node ./scripts/check-production-api-config.js",
    "package": "npm run package:linux",
    "package:linux": "npm run build && electron-builder --linux && sha256sum release/*.deb release/*.AppImage > release/SHA256SUMS.txt"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.20.0",
    "fabric": "^7.4.0",
    "lucide-react": "^1.56.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "tech.unicores.examguard",
    "productName": "ExamGuard",
    "icon": "images/04_app_icon_main.png",
    "protocols": [
      {
        "name": "ExamGuard launch",
        "schemes": [
          "examguard"
        ]
      },
      {
        "name": "UniCORE exam launch",
        "schemes": [
          "unicore-exam"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config/production.json",
        "to": "config/production.json"
      }
    ],
    "linux": {
      "category": "Education",
      "maintainer": "UniCORE",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
